# Artifact Viewer Environment Variables (non-Docker local dev — see
# README.md; for `docker compose up` this app reads the root .env instead).

ANTHROPIC_API_KEY=sk-ant-your-key-here

# /api/chat's router (src/lib/unified-chat/agent-router.ts) classifies each
# message as an artifact or database request — a cheap classification call,
# so it uses Haiku rather than a frontier model.
AGENT_ROUTER_MODEL=claude-haiku-4-5-20251001

# This app's own database — chat session history only (see
# prisma/schema.prisma). Deliberately separate from tool-service's own
# DATABASE_URL/DIRECT_URL (services/tool-service/.env) — a different
# Postgres database, not a table on tool-service's. Point this at any
# reachable Postgres you control (a local install, or a cloud instance —
# e.g. a second/separate Supabase project, never the same one tool-service
# uses).
SESSION_DATABASE_URL="postgresql://user:password@host:5432/artifacts_viewer"
