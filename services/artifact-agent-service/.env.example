# Artifact Agent Service Environment Variables

# --- Used directly by this service's own code (src/config.ts) ---

# Port this service listens on.
PORT=5102

# Where artifacts-server lives — used to build each response's preview_url.
ARTIFACTS_SERVER_URL=http://localhost:3400

# Filesystem root opencode writes artifacts into. Defaults to
# ../artifacts-server/artifacts relative to this service — override only if
# your artifacts directory lives somewhere else.
# ARTIFACTS_ROOT=../artifacts-server/artifacts

# The opencode binary to shell out to. Defaults to "opencode", resolved via
# PATH — override only if it's not on PATH under that name.
# OPENCODE_BIN=opencode

# How long a single opencode turn may run before this service times it out.
# A large multi-screen artifact can legitimately take several minutes.
# OPENCODE_TIMEOUT_SECONDS=900

# NOTE: there is no LLM_PROVIDER/ANTHROPIC_MODEL/GEMINI_MODEL here — provider
# and model switching was removed. opencode is always driven with a fixed
# model (OPENCODE_MODEL, a constant in src/config.ts) — change that constant,
# not an env var, to move models.

# --- Not read by this service's own code — inherited wholesale by the
#     opencode subprocess (opencode-runner.ts spawns it with no explicit
#     `env`, so it gets this whole process's environment) ---

# Where opencode's get_tools tool (services/artifacts-server/artifacts/
# .opencode/tool/get_tools.ts) looks up the live tool catalog. Defaults to
# http://localhost:5104 if unset.
TOOL_SERVICE_URL=http://localhost:5104

# opencode's own Anthropic credential. Optional here: opencode can instead
# be authenticated once via `opencode auth login`. Set this only if you'd
# rather have opencode pick up a credential from this service's environment.
# ANTHROPIC_API_KEY=<your Anthropic API key>
