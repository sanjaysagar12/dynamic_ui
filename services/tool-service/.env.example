# Direct Postgres connection (transaction-mode pooler recommended for app traffic).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Session-mode connection used by Prisma for migrations.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=5104

# The single most sensitive secret in this service — generate a real random
# value (e.g. `openssl rand -hex 48`), never reuse this placeholder.
JWT_SECRET=changeme-generate-a-real-secret
